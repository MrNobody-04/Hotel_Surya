datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
}

enum RoomType {
  AC
  NON_AC
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum StayStatus {
  ACTIVE
  CHECKED_OUT
  CANCELLED
}

enum BillItemCategory {
  ROOM
  FOOD
  DRINK
  SERVICE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QR_PAYMENT
  CARD
  OTHER
}

enum ExpenseCategory {
  SALARY
  FOOD_PURCHASE
  ELECTRICITY
  WATER
  INTERNET
  GAS
  MAINTENANCE
  CLEANING
  SUPPLIES
  TRANSPORTATION
  RENT
  REPAIRS
  MARKETING
  OTHER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(RECEPTIONIST)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  staysCreated  Stay[]       @relation("StayCreatedBy")
  payments      Payment[]    @relation("PaymentRecordedBy")
  expenses      Expense[]    @relation("ExpenseCreatedBy")
  auditLogs     AuditLog[]   @relation("UserAuditLogs")
  billItems     BillItem[]   @relation("BillItemCreatedBy")
  creditBillsCreated CreditBill[]        @relation("CreditBillCreatedBy")
  creditPayments     CreditPayment[]     @relation("CreditPaymentRecordedBy")
  creditLedgers      CreditLedgerEntry[] @relation("CreditLedgerCreatedBy")
  creditAdjustments  CreditAdjustment[]  @relation("CreditAdjustmentCreatedBy")

  @@index([email])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  type       RoomType   @default(NON_AC)
  status     RoomStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  stays Stay[]

  @@index([roomNumber])
  @@index([status])
}

model Customer {
  id                  String   @id @default(cuid())
  fullName            String
  gender              Gender   @default(PREFER_NOT_TO_SAY)
  citizenshipNumber   String?
  citizenshipPhotoUrl String?
  contactNumber       String
  address             String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stays Stay[]
  creditAccount CreditAccount?
  creditBills   CreditBill[]

  @@index([fullName])
  @@index([contactNumber])
  @@index([citizenshipNumber])
}

model AccompanyingGuest {
  id        String   @id @default(cuid())
  stayId    String
  stay      Stay     @relation(fields: [stayId], references: [id], onDelete: Cascade)
  fullName  String
  gender    Gender   @default(PREFER_NOT_TO_SAY)
  createdAt DateTime @default(now())

  @@index([stayId])
}

model Stay {
  id                   String     @id @default(cuid())
  customerId           String
  customer             Customer   @relation(fields: [customerId], references: [id])
  roomId               String
  room                 Room       @relation(fields: [roomId], references: [id])
  numberOfPeople       Int        @default(1)
  expectedCheckoutDate DateTime
  checkInAt            DateTime   @default(now())
  checkoutAt           DateTime?
  roomPrice            Float
  status               StayStatus @default(ACTIVE)
  notes                String?

  createdById          String
  createdBy            User       @relation("StayCreatedBy", fields: [createdById], references: [id])

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  accompanyingGuests   AccompanyingGuest[]
  billItems            BillItem[]
  payments             Payment[]

  @@index([customerId])
  @@index([roomId])
  @@index([status])
  @@index([checkInAt])
  @@index([checkoutAt])
}

model BillItem {
  id          String           @id @default(cuid())
  stayId      String
  stay        Stay             @relation(fields: [stayId], references: [id], onDelete: Cascade)
  category    BillItemCategory @default(OTHER)
  name        String
  quantity    Int              @default(1)
  unitPrice   Float
  total       Float
  notes       String?

  createdById String?
  createdBy   User?            @relation("BillItemCreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime         @default(now())

  @@index([stayId])
  @@index([category])
}

model ServiceItem {
  id           String           @id @default(cuid())
  name         String           @unique
  category     BillItemCategory @default(OTHER)
  categoryName String?
  defaultPrice Float
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  creditBillItems CreditBillItem[]

  @@index([category])
  @@index([categoryName])
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([sortOrder])
}

model Payment {
  id             String        @id @default(cuid())
  stayId         String
  stay           Stay          @relation(fields: [stayId], references: [id], onDelete: Cascade)
  amount         Float
  method         PaymentMethod @default(CASH)
  timestamp      DateTime      @default(now())
  notes          String?
  idempotencyKey String?       @unique

  recordedById   String?
  recordedBy     User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt      DateTime      @default(now())

  @@index([stayId])
  @@index([timestamp])
  @@index([method])
}

model Expense {
  id            String          @id @default(cuid())
  title         String
  amount        Float
  category      ExpenseCategory @default(OTHER)
  date          DateTime        @default(now())
  paymentMethod PaymentMethod   @default(CASH)
  notes         String?
  receiptUrl    String?

  createdById   String
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  entity    String
  entityId  String?
  metadata  String?  // JSON string
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([action])
  @@index([entity])
  @@index([userId])
}

enum DiningAreaType {
  CABIN
  HALL
}

enum DiningOrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model DiningTable {
  id        String         @id @default(cuid())
  name      String         @unique // "Cabin 1", "Cabin 2", "Cabin 3", "Hall 1", "Hall 2", "Hall 3"
  type      DiningAreaType @default(CABIN)
  status    RoomStatus     @default(AVAILABLE) // AVAILABLE, OCCUPIED
  capacity  Int            @default(4)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  orders    DiningOrder[]

  @@index([name])
  @@index([status])
  @@index([type])
}

model DiningOrder {
  id            String            @id @default(cuid())
  tableId       String
  table         DiningTable       @relation(fields: [tableId], references: [id])
  customerName  String?
  customerPhone String?
  guestCount    Int               @default(1)
  status        DiningOrderStatus @default(ACTIVE)
  totalAmount   Float             @default(0)
  paidAmount    Float             @default(0)
  paymentMethod PaymentMethod?
  notes         String?
  createdById   String?
  settledAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items         DiningOrderItem[]

  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@index([settledAt])
}

model DiningOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     DiningOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category  BillItemCategory @default(FOOD)
  name      String
  quantity  Int              @default(1)
  unitPrice Float
  total     Float
  notes     String?
  createdAt DateTime         @default(now())

  @@index([orderId])
}

model PaymentQr {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  qrImageUrl    String
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

enum CreditAccountStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum CreditBillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CreditLedgerType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
}

model CreditAccount {
  id             String              @id @default(cuid())
  customerId     String              @unique
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status         CreditAccountStatus @default(PAID)
  creditLimit    Float?
  totalCharged   Float               @default(0)
  totalPaid      Float               @default(0)
  currentBalance Float               @default(0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  bills          CreditBill[]
  payments       CreditPayment[]
  ledgerEntries  CreditLedgerEntry[]
  adjustments    CreditAdjustment[]

  @@index([customerId])
  @@index([status])
  @@index([currentBalance])
}

model CreditBill {
  id            String           @id @default(cuid())
  billNumber    String           @unique
  accountId     String
  account       CreditAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  status        CreditBillStatus @default(PENDING)
  subtotal      Float            @default(0)
  discount      Float            @default(0)
  tax           Float            @default(0)
  serviceCharge Float            @default(0)
  totalAmount   Float            @default(0)
  paidAmount    Float            @default(0)
  dueDate       DateTime?
  notes         String?
  createdById   String?
  createdBy     User?            @relation("CreditBillCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items         CreditBillItem[]
  payments      CreditPayment[]
  adjustments   CreditAdjustment[]

  @@index([accountId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
}

model CreditBillItem {
  id            String       @id @default(cuid())
  billId        String
  bill          CreditBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceItemId String?
  serviceItem   ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  name          String
  category      String?
  quantity      Int          @default(1)
  unitPrice     Float
  total         Float
  originalPrice Float?
  isCustom      Boolean      @default(false)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([billId])
  @@index([serviceItemId])
}

model CreditPayment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  accountId       String
  account         CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  billId          String?
  bill            CreditBill?   @relation(fields: [billId], references: [id], onDelete: SetNull)
  amount          Float
  paymentMethod   PaymentMethod @default(CASH)
  previousBalance Float         @default(0)
  remainingBalance Float        @default(0)
  notes           String?
  referenceNumber String?
  idempotencyKey  String?       @unique
  recordedById    String?
  recordedBy      User?         @relation("CreditPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([accountId])
  @@index([billId])
  @@index([createdAt])
  @@index([paymentMethod])
}

model CreditLedgerEntry {
  id              String           @id @default(cuid())
  accountId       String
  account         CreditAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type            CreditLedgerType
  amount          Float
  debit           Float            @default(0)
  credit          Float            @default(0)
  runningBalance  Float
  description     String
  referenceId     String?
  referenceNumber String?
  createdById     String?
  createdBy       User?            @relation("CreditLedgerCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

model CreditAdjustment {
  id          String        @id @default(cuid())
  accountId   String
  account     CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  billId      String?
  bill        CreditBill?   @relation(fields: [billId], references: [id], onDelete: SetNull)
  amount      Float
  reason      String
  oldTotal    Float
  newTotal    Float
  createdById String?
  createdBy   User?         @relation("CreditAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([accountId])
  @@index([billId])
  @@index([createdAt])
}


